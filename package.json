{
  "name": "vetted",
  "version": "0.2.0",
  "private": true,
  "description": "Vetted — every APm raw material evaluation in one filterable grid",
  "author": "Alex · APm R&D",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "scan": "node scripts/scan.js",
    "scan:dry": "node scripts/scan.js --dry",
    "demo:data": "node scripts/make-demo.js",
    "log": "node scripts/rm-log.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && electron-builder --win --x64",
    "release": "npm run electron:build && node scripts/publish-release.js",
    "icons": "node scripts/run-electron.js scripts/make-icons.cjs",
    "shots": "node scripts/run-electron.js scripts/screenshot.cjs scripts/shots.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.apm.vetted",
    "productName": "Vetted",
    "copyright": "Copyright © 2026 Alex · APm R&D",
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Vetted"
    },
    "publish": {
      "provider": "github",
      "owner": "alxkim97",
      "repo": "vetted"
    }
  }
}
